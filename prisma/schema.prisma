// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  avatar    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  spots         Spot[]
  routes        Route[]
  journeys      Journey[]
  comments      Comment[]
  savedItems    SavedItem[]
  stories       Story[]
  moments       Moment[]
  followers     Follow[]       @relation("UserFollowers")
  following     Follow[]       @relation("UserFollowing")
  notifications Notification[]

  @@map("users")
}

model Spot {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  name        String   @db.VarChar(150)
  description String?  @db.Text
  image       String?  @db.Text
  location    String?  @db.VarChar(150)
  latitude    Decimal  @default(10.0889) @db.Decimal(10, 8)
  longitude   Decimal  @default(77.0595) @db.Decimal(11, 8)
  category    String   @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments   Comment[]
  savedItems SavedItem[]

  @@map("spots")
}

model Route {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  title            String    @db.VarChar(150)
  coverImage       String?   @map("cover_image") @db.Text
  shortDescription String?   @map("short_description") @db.Text
  description      String?   @db.Text
  location         String?   @db.VarChar(150)
  category         String    @db.VarChar(50)
  difficulty       String    @default("Moderate") @db.VarChar(50)
  visibility       String    @default("Public") @db.VarChar(50)
  distance         String?   @db.VarChar(50)
  duration         String?   @db.VarChar(50)
  places           Json?     @db.JsonB
  highlights       Json?     @db.JsonB
  likesCount       Int       @default(0) @map("likes_count")
  commentsCount    Int       @default(0) @map("comments_count")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  journeys   Journey[]
  comments   Comment[]
  savedItems SavedItem[]

  @@map("routes")
}

model Journey {
  id               Int             @id @default(autoincrement())
  userId           Int             @map("user_id")
  routeId          Int             @map("route_id")
  status           String          @default("IN_PROGRESS") @db.VarChar(50)
  currentSpotIndex Int             @default(0) @map("current_spot_index")
  exploredSpots    Json?           @default("[]") @map("explored_spots") @db.JsonB
  totalDuration    String?         @map("total_duration") @db.VarChar(50)
  startedAt        DateTime        @default(now()) @map("started_at")
  completedAt      DateTime?       @map("completed_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  route   Route           @relation(fields: [routeId], references: [id], onDelete: Cascade)
  moments JourneyMoment[]

  @@map("journeys")
}

model JourneyMoment {
  id         Int      @id @default(autoincrement())
  journeyId  Int      @map("journey_id")
  spotId     String?  @map("spot_id") @db.VarChar(100)
  spotName   String?  @map("spot_name") @db.VarChar(150)
  type       String   @default("photo") @db.VarChar(50)
  mediaUrl   String?  @map("media_url") @db.Text
  caption    String?  @db.Text
  visibility String   @default("public") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@map("journey_moments")
}

model Comment {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  routeId    Int?     @map("route_id")
  spotId     Int?     @map("spot_id")
  parentId   Int?     @map("parent_id")
  text       String   @db.Text
  likesCount Int      @default(0) @map("likes_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  route Route? @relation(fields: [routeId], references: [id], onDelete: Cascade)
  spot  Spot?  @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model SavedItem {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  routeId   Int?     @map("route_id")
  spotId    Int?     @map("spot_id")
  momentId  Int?     @map("moment_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  route  Route?  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  spot   Spot?   @relation(fields: [spotId], references: [id], onDelete: Cascade)
  moment Moment? @relation(fields: [momentId], references: [id], onDelete: Cascade)

  @@map("saved_items")
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int      @map("follower_id")
  followingId Int      @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  actorId   Int?     @map("actor_id")
  type      String   @db.VarChar(50)
  category  String   @default("All") @db.VarChar(50)
  title     String   @db.VarChar(200)
  message   String   @db.Text
  data      Json?    @db.JsonB
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Story {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  routeId   Int?      @map("route_id")
  title     String    @db.VarChar(150)
  image     String    @db.Text
  mediaUri  String?   @map("media_uri") @db.Text
  type      String    @default("image") @db.VarChar(20)
  caption   String?   @db.Text
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stories")
}

model Moment {
  id            Int         @id @default(autoincrement())
  userId        Int         @map("user_id")
  routeId       Int?        @map("route_id")
  spotId        Int?        @map("spot_id")
  type          String      @default("photo") @db.VarChar(20)
  mediaUri      String?     @map("media_uri") @db.Text
  noteText      String?     @map("note_text") @db.Text
  caption       String?     @db.Text
  visibility    String      @default("Public") @db.VarChar(20)
  likesCount    Int         @default(0) @map("likes_count")
  commentsCount Int         @default(0) @map("comments_count")
  tags          Json?       @db.JsonB
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedItems SavedItem[]

  @@map("moments")
}
